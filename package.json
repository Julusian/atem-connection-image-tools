{
  "name": "@atem-connection/image-tools",
  "version": "2.0.0",
  "description": "Native tools for atem-connection",
  "type": "module",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Julusian/atem-connection-image-tools.git"
  },
  "bugs": {
    "url": "https://github.com/Julusian/atem-connection-image-tools/issues"
  },
  "homepage": "https://github.com/Julusian/atem-connection-image-tools#readme",
  "maintainers": [
    {
      "name": "Julian Waller",
      "email": "git@julusian.co.uk"
    }
  ],
  "scripts": {
    "postinstall": "husky",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable",
    "build": "yarn build:rs && yarn build:js",
    "build:rs": "napi build --manifest-path native/Cargo.toml --platform --release --no-js --dts nativeLib.d.cts --output-dir .",
    "build:rs:debug": "napi build --manifest-path native/Cargo.toml --platform --no-js --dts nativeLib.d.cts --output-dir .",
    "build:js": "rimraf dist && run build:main --force",
    "build:main": "tsc --build tsconfig.json",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint": "yarn lint:eslint && yarn lint:prettier",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:prettier:fix",
    "unit": "run unit:js && run unit:rs",
    "unit:js": "vitest run",
    "unit:rs": "cd native && cargo test",
    "test": "run lint && run unit",
    "watch": "vitest",
    "reset": "git clean -dfx && git reset --hard && yarn",
    "validate:dependencies": "yarn npm audit --environment production && run license-validate",
    "validate:dev-dependencies": "yarn npm audit --environment development",
    "license-validate": "sofie-licensecheck --allowPackages caniuse-lite@1.0.30001319"
  },
  "engines": {
    "node": "^22.16 || >=24"
  },
  "files": [
    "/dist",
    "/assets",
    "/CHANGELOG.md",
    "/README.md",
    "/LICENSE",
    "prebuilds",
    "nativeLib.*"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@sofie-automation/code-standard-preset": "~4.0.4",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "pinst": "^3.0.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "prettier": "@sofie-automation/code-standard-preset/prettier.config.mjs",
  "lint-staged": {
    "*.{css,json,md,scss,yaml,yml}": [
      "prettier --check"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint"
    ]
  },
  "napi": {
    "binaryName": "atem-connection-image-tools",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
