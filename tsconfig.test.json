{
	"extends": "@sofie-automation/code-standard-preset/ts/tsconfig.lib",
	"include": ["src/**/*spec.ts", "src/**/__tests__/*", "src/**/__mocks__/*", "vitest.config.mts"],
	"exclude": ["node_modules/**", "scratch/**"],
	"compilerOptions": {
		"rootDir": "./",
		"outDir": "./dist",
		"types": ["node"],
		"skipLibCheck": true,
		"noEmit": true,
		"tsBuildInfoFile": "./node_modules/.cache/tsconfig.test.tsbuildinfo"
	},
	"references": [{ "path": "./tsconfig.build.json" }]
}
